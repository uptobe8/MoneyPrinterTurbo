FROM ghcr.io/harry0703/moneyprinterturbo:latest

USER root
WORKDIR /MoneyPrinterTurbo

RUN apt-get update && apt-get install -y --no-install-recommends espeak && rm -rf /var/lib/apt/lists/*

RUN if [ ! -f config.toml ] && [ -f config.example.toml ]; then cp config.example.toml config.toml; fi

RUN mkdir -p /MoneyPrinterTurbo/storage/local_videos && \
    ffmpeg -y -loglevel error -f lavfi -i "color=c=#b99574:s=1080x1920:d=7:r=25" -vf "drawbox=x=80:y=180:w=360:h=760:color=#f5dfb8@0.75:t=fill,drawbox=x=0:y=1310:w=1080:h=610:color=#6e513f:t=fill,drawbox=x=650:y=500:w=230:h=520:color=#526347:t=fill,drawbox=x=705:y=400:w=120:h=120:color=#d9b79b:t=fill,drawbox=x=840:y=260:w=90:h=260:color=#557a45:t=fill" -c:v libx264 -pix_fmt yuv420p /MoneyPrinterTurbo/storage/local_videos/testimonial-scene-1.mp4 && \
    ffmpeg -y -loglevel error -f lavfi -i "color=c=#c9c3b8:s=1080x1920:d=7:r=25" -vf "drawbox=x=120:y=0:w=840:h=1920:color=#d8d0c4:t=fill,drawbox=x=610:y=420:w=300:h=980:color=#6b574b:t=fill,drawbox=x=655:y=500:w=210:h=790:color=#8a7465:t=fill,drawbox=x=250:y=650:w=210:h=520:color=#526347:t=fill,drawbox=x=305:y=560:w=105:h=105:color=#d9b79b:t=fill" -c:v libx264 -pix_fmt yuv420p /MoneyPrinterTurbo/storage/local_videos/testimonial-scene-2.mp4 && \
    ffmpeg -y -loglevel error -f lavfi -i "color=c=#c7a27f:s=1080x1920:d=7:r=25" -vf "drawbox=x=0:y=0:w=1080:h=720:color=#d6b58d:t=fill,drawbox=x=0:y=1330:w=1080:h=590:color=#654c3c:t=fill,drawbox=x=560:y=520:w=245:h=560:color=#526347:t=fill,drawbox=x=625:y=420:w=115:h=115:color=#dab99e:t=fill,drawbox=x=275:y=1120:w=250:h=90:color=#2e2f31:t=fill,drawbox=x=315:y=1040:w=60:h=100:color=#2e2f31:t=fill" -c:v libx264 -pix_fmt yuv420p /MoneyPrinterTurbo/storage/local_videos/testimonial-scene-3.mp4 && \
    ffmpeg -y -loglevel error -f lavfi -i "color=c=#d5b27f:s=1080x1920:d=7:r=25" -vf "drawbox=x=170:y=200:w=740:h=1500:color=#b79a79:t=fill,drawbox=x=360:y=560:w=360:h=1040:color=#695347:t=fill,drawbox=x=220:y=980:w=120:h=380:color=#536448:t=fill,drawbox=x=250:y=900:w=60:h=60:color=#d8b89d:t=fill,drawbox=x=760:y=990:w=105:h=350:color=#4f5f73:t=fill,drawbox=x=790:y=920:w=55:h=55:color=#ddb99b:t=fill,drawbox=x=490:y=1080:w=85:h=260:color=#6c8aa2:t=fill,drawbox=x=510:y=1020:w=45:h=45:color=#e0bb9e:t=fill,drawbox=x=600:y=1100:w=85:h=240:color=#b56d57:t=fill,drawbox=x=620:y=1040:w=45:h=45:color=#e0bb9e:t=fill" -c:v libx264 -pix_fmt yuv420p /MoneyPrinterTurbo/storage/local_videos/testimonial-scene-4.mp4 && \
    ffmpeg -y -loglevel error -f lavfi -i "color=c=#d58a5f:s=1080x1920:d=7:r=25" -vf "drawbox=x=0:y=0:w=1080:h=770:color=#efb477:t=fill,drawbox=x=0:y=770:w=1080:h=1150:color=#80634d:t=fill,drawbox=x=80:y=680:w=300:h=900:color=#6c5546:t=fill,drawbox=x=700:y=600:w=300:h=980:color=#5e4d43:t=fill,drawbox=x=745:y=790:w=115:h=140:color=#f2cf7c@0.85:t=fill,drawbox=x=420:y=950:w=230:h=560:color=#526347:t=fill,drawbox=x=480:y=850:w=110:h=110:color=#d9b79b:t=fill" -c:v libx264 -pix_fmt yuv420p /MoneyPrinterTurbo/storage/local_videos/testimonial-scene-5.mp4

COPY testimonial_prefill.py /MoneyPrinterTurbo/testimonial_prefill.py
COPY testimonial_selftest.py /MoneyPrinterTurbo/testimonial_selftest.py

EXPOSE 8501

CMD ["streamlit", "run", "./testimonial_prefill.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.enableCORS=true", "--browser.gatherUsageStats=false", "--client.toolbarMode=minimal", "--logger.hideWelcomeMessage=true", "--server.showEmailPrompt=false"]
